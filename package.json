{
  "name": "customs-erp",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup": "node scripts/db-provider.js && prisma generate && prisma db push && node prisma/seed.js",
    "vercel-build": "node scripts/db-provider.js && prisma generate && prisma db push --skip-generate && node prisma/seed.js && next build",
    "postinstall": "node scripts/db-provider.js && prisma generate",
    "build:static": "node scripts/static-schema.js && vite build --config static/vite.config.mjs",
    "data:static": "node scripts/static-schema.js && node scripts/static-data.js",
    "dev:static": "vite --config static/vite.config.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "lucide-react": "^1.77.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "react-dom19": "npm:react-dom@^19.0.0",
    "react-router-dom": "^6.28.0",
    "react19": "npm:react@^19.0.0",
    "tailwindcss": "3.4.19",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=18.18"
  }
}
